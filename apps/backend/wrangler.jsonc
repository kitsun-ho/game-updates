{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-updates-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "CORS_ORIGINS": "http://localhost:3000,https://kitsun.cc,https://www.kitsun.cc"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-updates-db",
      "database_id": "b024c375-fbd9-488c-8a23-694a811dd552",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 1,13 * * *"]
  }
}
